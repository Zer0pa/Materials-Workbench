# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Audit runtime files (append-only logs are persisted in `audit/runtime/` ONLY for live runs;
