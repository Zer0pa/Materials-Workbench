.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Bulk artefacts (no-bulk-local-data invariant, PRD §Hard Gates)
*.h5
*.hdf5
*.npz
data/raw/
data/bulk/
checkpoints/

# Logs
*.log
logs/
